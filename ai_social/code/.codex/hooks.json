{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./.codex/scripts/validate-codex-scaffold.sh"
          },
          {
            "type": "command",
            "command": "./.codex/scripts/validate-brief-parse-contract.sh"
          },
          {
            "type": "command",
            "command": "./.codex/scripts/check-dry-run-boundaries.sh"
          }
        ]
      }
    ]
  }
}
